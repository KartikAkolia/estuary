---
// Shared shell for every Estuary route (course index + module chapters):
// dwm-style top bar (carried over from fjord's Nord Terminal direction) plus
// a term-grouped table-of-contents sidebar, reinterpreting Fjord's
// three-pane file browser as a two-pane book/e-reader layout.
import { getCollection } from "astro:content";
import { TERM_GROUPS, sortModules } from "../lib/terms";

interface Props {
  activeCode?: string;
  pageTitle: string;
}
const { activeCode, pageTitle } = Astro.props;

const allModules = sortModules(await getCollection("modules"));
const totalCredits = allModules.reduce((sum, m) => sum + m.data.credits, 0);
const today = new Date().toISOString().slice(0, 10);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle} — Estuary</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap"
    />
  </head>
  <body>
    <div class="frame">
      <!-- dwm-style status bar -->
      <header class="statusbar">
        <a href="/" class="brand">estuary</a>
        <span class="course-id">P12069 · BSc (Hons) Computer Science · Year 0</span>
        <div class="statusbar-right">
          <span>{allModules.length} modules</span>
          <span>{totalCredits} credits</span>
          <span class="dev">● starts 2026-09-14</span>
        </div>
      </header>

      <div class="panes">
        <!-- table of contents, grouped by term -->
        <nav class="toc-pane">
          <a href="/" class:list={["toc-heading", "toc-home", { active: !activeCode }]}>
            COURSE OVERVIEW
          </a>
          {
            TERM_GROUPS.map((group) => {
              const inGroup = allModules.filter((m) => m.data.termGroup === group.key);
              return (
                <Fragment>
                  <div class="toc-heading">{group.label}</div>
                  {inGroup.map((m) => (
                    <a
                      href={`/modules/${m.data.code}/`}
                      class:list={["toc-item", { active: m.data.code === activeCode }]}
                    >
                      <span class="toc-code">{m.data.code}</span>
                      <span class="toc-title">{m.data.title}</span>
                    </a>
                  ))}
                </Fragment>
              );
            })
          }
        </nav>

        <!-- reading pane -->
        <main class="reading-pane">
          <div class="prose">
            <slot />
          </div>
        </main>
      </div>

      <footer class="statusline">
        <slot name="footer">
          <span>estuary — pre-course study reader</span>
        </slot>
        <span class="statusline-right">{today}</span>
      </footer>
    </div>

    <style>
      :root {
        --n0: #2e3440;
        --n1: #3b4252;
        --n2: #434c5e;
        --n3: #4c566a;
        --n4: #d8dee9;
        --n6: #eceff4;
        --frost2: #88c0d0;
        --frost3: #81a1c1;
        --yellow: #ebcb8b;
        --green: #a3be8c;
        --red: #bf616a;
        --purple: #b48ead;
      }
      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        height: 100%;
        background: var(--n0);
        color: var(--n6);
        font-family: "JetBrains Mono", ui-monospace, monospace;
        font-size: 13px;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      .frame {
        display: flex;
        flex-direction: column;
        height: 100vh;
        overflow: hidden;
      }

      /* status bar */
      .statusbar {
        height: 30px;
        flex: none;
        background: var(--n1);
        display: flex;
        align-items: center;
        padding: 0 14px;
        gap: 18px;
        border-bottom: 1px solid var(--n2);
      }
      .statusbar .brand {
        color: var(--yellow);
        font-weight: 700;
      }
      .course-id {
        color: var(--n4);
        font-size: 12px;
      }
      .statusbar-right {
        margin-left: auto;
        display: flex;
        gap: 16px;
        color: var(--n4);
        font-size: 12px;
      }
      .statusbar-right .dev {
        color: var(--green);
      }

      /* panes */
      .panes {
        flex: 1;
        display: flex;
        min-height: 0;
      }
      .toc-pane {
        width: 300px;
        flex: none;
        border-right: 1px solid var(--n2);
        padding: 18px 0;
        overflow-y: auto;
      }
      .toc-heading {
        display: block;
        padding: 10px 18px 4px;
        color: var(--n3);
        font-size: 11px;
        letter-spacing: 1px;
      }
      .toc-home {
        color: var(--frost2);
        font-weight: 700;
      }
      .toc-home.active {
        color: var(--yellow);
      }
      .toc-item {
        display: flex;
        flex-direction: column;
        padding: 6px 18px;
        border-left: 2px solid transparent;
      }
      .toc-item.active {
        background: var(--n1);
        border-left-color: var(--frost2);
      }
      .toc-item:hover:not(.active) {
        background: var(--n1);
      }
      .toc-code {
        color: var(--frost2);
        font-size: 11px;
      }
      .toc-item.active .toc-code {
        color: var(--yellow);
      }
      .toc-title {
        color: var(--n4);
        font-size: 12px;
      }

      .reading-pane {
        flex: 1;
        overflow-y: auto;
        padding: 28px 40px;
        min-width: 0;
      }

      /* chapter typography */
      .prose {
        max-width: 880px;
        line-height: 1.7;
        color: var(--n4);
      }
      .prose h1,
      .prose h2,
      .prose h3,
      .prose h4 {
        color: var(--n6);
        line-height: 1.4;
      }
      .prose h1 {
        color: var(--yellow);
        font-size: 1.5em;
        border-bottom: 1px solid var(--n2);
        padding-bottom: 8px;
      }
      .prose h2 {
        font-size: 1.15em;
        margin-top: 2em;
        color: var(--frost2);
      }
      .prose h3 {
        font-size: 1.05em;
        margin-top: 1.6em;
      }
      .prose a {
        color: var(--frost2);
        text-decoration: underline;
        text-decoration-color: var(--n2);
      }
      .prose a:hover {
        color: var(--yellow);
      }
      .prose code {
        background: var(--n1);
        color: var(--yellow);
        padding: 1px 5px;
        border-radius: 3px;
        font-size: 0.95em;
      }
      .prose blockquote {
        border-left: 2px solid var(--purple);
        margin: 1em 0;
        padding-left: 14px;
        color: var(--n3);
      }
      .prose ul,
      .prose ol {
        padding-left: 1.4em;
      }
      .prose li {
        margin: 4px 0;
      }
      .prose li::marker {
        color: var(--frost2);
      }
      .prose table {
        border-collapse: collapse;
        width: 100%;
        margin: 1em 0;
        font-size: 0.95em;
      }
      .prose th,
      .prose td {
        border: 1px solid var(--n2);
        padding: 6px 10px;
        text-align: left;
      }
      .prose th {
        background: var(--n1);
        color: var(--n6);
      }
      .prose hr {
        border: none;
        border-top: 1px solid var(--n2);
        margin: 2em 0;
      }

      /* In Depth section */
      .indepth-note {
        color: var(--n3);
        font-size: 0.85em;
        font-style: italic;
        border-left: 2px solid var(--n2);
        padding-left: 12px;
        margin: 0.6em 0 1.6em;
      }

      /* original diagrams */
      .visuals {
        margin: 1.6em 0 2.2em;
        display: flex;
        flex-direction: column;
        gap: 20px;
      }
      .visual {
        margin: 0;
        border: 1px solid var(--n2);
        border-radius: 4px;
        padding: 16px;
        background: var(--n1);
      }
      .visual img {
        display: block;
        max-width: 100%;
        height: auto;
        margin: 0 auto;
      }
      .visual figcaption {
        margin-top: 10px;
        color: var(--n3);
        font-size: 0.85em;
        text-align: center;
      }

      /* module cards on the course index */
      .module-card {
        display: block;
        border: 1px solid var(--n2);
        border-radius: 4px;
        padding: 14px 18px;
        margin: 10px 0;
      }
      .module-card:hover {
        border-color: var(--frost2);
      }
      .module-card .code {
        color: var(--frost2);
        font-size: 12px;
      }
      .module-card .title {
        color: var(--n6);
        font-size: 1.05em;
        margin: 2px 0 6px;
      }
      .module-card .meta {
        color: var(--n3);
        font-size: 12px;
      }

      /* prev/next chapter nav */
      .chapter-nav {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        margin-top: 2.5em;
        padding-top: 1.2em;
        border-top: 1px solid var(--n2);
      }
      .chapter-nav a {
        border: 1px solid var(--n2);
        border-radius: 4px;
        padding: 8px 14px;
        color: var(--n4);
        max-width: 45%;
      }
      .chapter-nav a:hover {
        border-color: var(--frost2);
        color: var(--n6);
      }
      .chapter-nav .direction {
        display: block;
        color: var(--n3);
        font-size: 11px;
      }
      .chapter-nav .next {
        margin-left: auto;
        text-align: right;
      }

      /* status line */
      .statusline {
        height: 26px;
        flex: none;
        background: var(--n1);
        border-top: 1px solid var(--n2);
        display: flex;
        align-items: center;
        padding: 0 14px;
        font-size: 12px;
        color: var(--n4);
        gap: 20px;
      }
      .statusline-right {
        margin-left: auto;
        color: var(--n3);
      }
    </style>
  </body>
</html>
